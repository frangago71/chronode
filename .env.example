# ==============================================================================
# Chronode - Variables de entorno (Plantilla de configuración)
# Copia este archivo a '.env' antes de iniciar los servicios:
# cp .env.example .env
# ==============================================================================

# --- Base de datos (PostgreSQL / Docker Compose) ---
POSTGRES_DB=chronode_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5433

# --- Backend (Spring Boot 3) ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/chronode_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# --- Seguridad y Tokens JWT ---
# Clave secreta para firma HMAC-SHA256 (mínimo 256 bits / 32 bytes)
# IMPORTANTE: Generar una clave aleatoria y segura para entornos de producción
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Tiempo de expiración del token en milisegundos (3600000 ms = 1 hora)
JWT_EXPIRATION_MS=3600000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080/api/v1
